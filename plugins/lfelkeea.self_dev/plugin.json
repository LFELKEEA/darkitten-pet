{
  "id": "lfelkeea.self_dev",
  "name": "自开发工坊（Agent 工具链）",
  "version": "1.1.1",
  "api_version": 1,
  "entry": "main.py",
  "description": "让桌宠拥有一套自己的编程工具：在专属开发区里读文件、改代码、跑命令、查语法、搜资料，并把成果做成新的桌宠插件安装到自己的插件目录。不再限制步数和输出长度，可以一直做到任务完成；改动会自动记录基线，一键就能还原到最初状态；做好的插件还能导出成 ZIP 分享或投稿。工作台会实时展示每一步调用，危险操作默认要主人点头；所有路径都相对于开发区，换一台电脑、换一个安装目录也能直接用。",
  "author": "LFELKEEA",
  "highlights": [
    {
      "label": "工作区",
      "value": "data/dev，路径自解析"
    },
    {
      "label": "工具",
      "value": "读 / 写 / 改 / 搜 / 跑"
    },
    {
      "label": "流程",
      "value": "不限步数，做到完成"
    },
    {
      "label": "产物",
      "value": "直接生成可启用插件"
    },
    {
      "label": "安全",
      "value": "目录沙箱 + 改动前备份"
    },
    {
      "label": "审批",
      "value": "命令与启用插件需确认"
    },
    {
      "label": "还原",
      "value": "一键退回初始状态"
    },
    {
      "label": "导出",
      "value": "插件打包成 ZIP"
    },
    {
      "label": "记录",
      "value": "每次任务留会话日志"
    },
    {
      "label": "可移植",
      "value": "不带本机路径和密钥"
    }
  ],
  "permissions": [
    "pet.say",
    "pet.action",
    "settings",
    "storage"
  ],
  "settings": {
    "approval_mode": "confirm_danger",
    "shell_mode": "auto",
    "temperature": 0.3,
    "allow_network": true,
    "allow_private_network": false,
    "allow_self_modify": false,
    "auto_enable_plugin": true,
    "notify_on_finish": true,
    "model_override": "",
    "workspace_dir": ""
  }
}
