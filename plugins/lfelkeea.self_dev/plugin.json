{
  "id": "lfelkeea.self_dev",
  "name": "自开发工坊（Agent 工具链）",
  "version": "1.2.0",
  "api_version": 1,
  "entry": "main.py",
  "description": "让桌宠拥有一套会积累的编程工具：在专属开发区里读文件、改代码、跑命令、查语法，还能用技能沉淀做法、用本地知识库检索旧结论、用连接器接入 HTTP API 和 MCP 服务器，并在不熟悉的库或报错面前主动搜索网页、GitHub 和 PyPI。成果可以直接做成新的桌宠插件安装到插件目录；不再限制步数和输出长度，可以一直做到任务完成。改动会自动记录基线，一键就能还原到最初状态；做好的插件还能导出成 ZIP 分享或投稿。工作台会实时展示每一步调用，危险操作默认要主人点头；所有路径都相对于开发区，换一台电脑、换一个安装目录也能直接用。",
  "author": "LFELKEEA",
  "highlights": [
    {
      "label": "技能",
      "value": "可复用做法库"
    },
    {
      "label": "知识库",
      "value": "本地检索 + 引用"
    },
    {
      "label": "连接器",
      "value": "HTTP API / MCP"
    },
    {
      "label": "联网",
      "value": "搜网页 / GitHub / PyPI"
    },
    {
      "label": "流程",
      "value": "不限步数，做到完成"
    },
    {
      "label": "产物",
      "value": "直接生成可启用插件"
    },
    {
      "label": "安全",
      "value": "目录沙箱 + 密钥打码"
    },
    {
      "label": "审批",
      "value": "命令、连接器、删除需确认"
    },
    {
      "label": "还原",
      "value": "一键退回初始状态"
    },
    {
      "label": "可移植",
      "value": "不带本机路径和密钥"
    }
  ],
  "permissions": [
    "pet.say",
    "pet.action",
    "settings",
    "storage"
  ],
  "settings": {
    "approval_mode": "confirm_danger",
    "shell_mode": "auto",
    "temperature": 0.3,
    "allow_network": true,
    "allow_private_network": false,
    "allow_connectors": true,
    "allow_self_modify": false,
    "auto_enable_plugin": true,
    "auto_learn": true,
    "notify_on_finish": true,
    "model_override": "",
    "workspace_dir": ""
  }
}
